# --- Supabase (local : généré par `node scripts/setup-env.mjs`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
SUPABASE_JWT_SECRET=

# --- App ---
# URL publique du site (OBLIGATOIRE en production : canonical, sitemap, Open Graph, retours Stripe).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (mode test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Webhooks entrants ---
WEBHOOK_SIGNING_SALT=

# --- Webhooks entrants / maintenance ---
# Clé maîtresse (32 caractères minimum, obligatoire en production) : dérive les secrets des webhooks et chiffre les secrets d'application Meta.
INBOUND_SECRET_KEY=
# Jeton de la route /api/cron/maintenance (Authorization: Bearer ...). Vide = route désactivée.
CRON_SECRET=
# Mettre à 1 derrière un proxy de confiance qui AJOUTE l'IP du client dans X-Forwarded-For (sinon l'IP est ignorée).
TRUSTED_PROXY=
# Géocodage : ban (défaut) ou mock (interdit en production). Contact exposé dans le User-Agent.
GEOCODER=
GEOCODER_CONTACT=

# --- Répartition automatique : itinéraires routiers et trafic (aucune clé obligatoire) ---
# Routage : osrm (défaut si ROUTING_URL), fake (tests, = GEOCODER=mock), estimate (repli étiqueté, validation automatique refusée).
# `npm run routing:setup` puis `npm run routing:up` démarrent OSRM en local (127.0.0.1:56500).
ROUTING_PROVIDER=
ROUTING_URL=http://127.0.0.1:56500
# Trafic optionnel (clé gratuite) : none | tomtom | mapbox. Appelé côté serveur uniquement, pour les trajets des tournées proposées.
# Sans clé : coefficients d'heure de pointe réglables dans Réglages > Membres > Réglages de la répartition.
TRAFFIC_PROVIDER=none
TRAFFIC_API_KEY=

# --- Facturation (Stripe, mode test) ---
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_* : voir plus haut ; `npm run stripe:setup` crée produits et prix.
# STRIPE_API_BASE=http://127.0.0.1:12111 pointe le SDK vers stripe-mock (`npm run stripe:mock`) ; ignoré en production.
STRIPE_API_BASE=

# --- Dev, seed et tests (facultatif) ---
# `npm run db:seed` refuse toute base non locale (et NODE_ENV=production) ; forcer exige ALLOW_REMOTE_SEED=1 ET CONFIRM_REMOTE_SEED=<hôte> (déconseillé).
ALLOW_REMOTE_SEED=
CONFIRM_REMOTE_SEED=
# Dossier de build Next alterné (builds parallèles sans collision), ex. .next-test.
NEXT_DIST_DIR=
