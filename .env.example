# --- Supabase (local : généré par `node scripts/setup-env.mjs`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
SUPABASE_JWT_SECRET=

# --- App ---
# URL publique du site (OBLIGATOIRE en production : canonical, sitemap, Open Graph, retours Stripe).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (mode test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_EXTRA_SEAT_STARTER=
STRIPE_PRICE_EXTRA_SEAT_PRO=
STRIPE_PRICE_EXTRA_SEAT_BUSINESS=

# --- Webhooks entrants ---
WEBHOOK_SIGNING_SALT=

# --- Webhooks entrants / maintenance ---
# Clé maîtresse (32 caractères minimum, obligatoire en production) : dérive les secrets des webhooks et chiffre les secrets d'application Meta.
INBOUND_SECRET_KEY=
# Jeton de la route /api/cron/maintenance (Authorization: Bearer ...). Vide = route désactivée.
CRON_SECRET=
# Voir « Sécurité » en bas de fichier (TRUSTED_PROXY=1 sur Vercel).
# Géocodage : ban (défaut) ou mock (interdit en production). Contact exposé dans le User-Agent.
GEOCODER=
GEOCODER_CONTACT=

# --- Répartition automatique : itinéraires routiers et trafic (aucune clé obligatoire) ---
# Routage : osrm (défaut si ROUTING_URL), fake (tests, = GEOCODER=mock), estimate (repli étiqueté, validation automatique refusée).
# `npm run routing:setup` puis `npm run routing:up` démarrent OSRM en local (127.0.0.1:56500).
ROUTING_PROVIDER=
ROUTING_URL=http://127.0.0.1:56500
# Trafic optionnel (clé gratuite) : none | tomtom | mapbox. Appelé côté serveur uniquement, pour les trajets des tournées proposées.
# Sans clé : coefficients d'heure de pointe réglables dans Réglages > Membres > Réglages de la répartition.
TRAFFIC_PROVIDER=none
TRAFFIC_API_KEY=

# Carte de la répartition (Leaflet) : modèle d'URL des tuiles. Défaut = tuiles publiques OpenStreetMap (usage léger/dev uniquement,
# politique d'usage OSM). En production, utilisez un fournisseur de tuiles dédié (MapTiler, Stadia, Mapbox, tuiles auto-hébergées...).
# Exemple : https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=VOTRE_CLE   (attribution « © OpenStreetMap contributors » conservée)
NEXT_PUBLIC_MAP_TILE_URL=

# --- Facturation (Stripe, mode test) ---
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_* : voir plus haut ; `npm run stripe:setup` crée produits et prix.
# STRIPE_API_BASE=http://127.0.0.1:12111 pointe le SDK vers stripe-mock (`npm run stripe:mock`) ; ignoré en production.
STRIPE_API_BASE=

# --- Dev, seed et tests (facultatif) ---
# `npm run db:seed` refuse toute base non locale (et NODE_ENV=production) ; forcer exige ALLOW_REMOTE_SEED=1 ET CONFIRM_REMOTE_SEED=<hôte> (déconseillé).
ALLOW_REMOTE_SEED=
CONFIRM_REMOTE_SEED=
# Dossier de build Next alterné (builds parallèles sans collision), ex. .next-test.
NEXT_DIST_DIR=

# --- Vérification e-mail à l'inscription (code à 6 chiffres) ---
# Obligatoire en production : secret qui signe les codes et la preuve de vérification (32 caractères aléatoires minimum).
EMAIL_CODE_SECRET=
# Envoi des e-mails transactionnels via Brevo. Sans BREVO_API_KEY : en développement le code s'affiche à l'écran ; en production l'inscription est impossible.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Orvolt

# --- Sécurité : IP client, rate limiting, code de dev ---
# TRUSTED_PROXY=1 : à activer sur Vercel (ou tout proxy de confiance qui AJOUTE l'IP du client à droite de X-Forwarded-For).
# Sans lui, l'IP est inconnue (X-Forwarded-For est forgeable) : les limites par IP se replient sur des clés par e-mail / globales
# (connexion : clé par e-mail seul, limite plus tolérante). Ne l'activez PAS si le serveur est exposé directement à Internet.
TRUSTED_PROXY=
# Rate limiting : persistant (RPC Postgres rate_limit_hit) en production, mémoire en dev/tests. Forcer : pg | memory.
RATE_LIMIT_STORE=
# ALLOW_DEV_CODE=1 : affiche le code e-mail à l'écran quand aucun fournisseur n'est configuré. Ignoré en production et sur Vercel (preview comprise).
ALLOW_DEV_CODE=

# --- Onboarding et URL publique ---
# ONBOARDING_REQUIRE_PLAN=0 désactive le choix obligatoire d'une formule à l'inscription (tests/développement). Par défaut : exigé dès que la facturation Stripe est configurée.
ONBOARDING_REQUIRE_PLAN=
# Fourni automatiquement par Vercel (domaine de production, sans https://) ; sert de repli à NEXT_PUBLIC_APP_URL pour canonical, sitemap et Open Graph. Ne le définissez pas à la main.
VERCEL_PROJECT_PRODUCTION_URL=
# Référencement : codes de vérification de propriété (Google Search Console, Bing Webmaster Tools). Facultatifs ; aucune balise n'est émise s'ils sont vides.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Notifications par e-mail (cron) ---
# GET /api/cron/notifications (Authorization: Bearer $CRON_SECRET) toutes les 15 minutes : rappels de RDV (veille, 1 h, client),
# tâches échues, essai se terminant dans 3 jours / expiré. Déclaré dans vercel.json ("*/15 * * * *" : plan Vercel Pro requis ;
# sur Hobby, appeler la route depuis un planificateur externe). Réutilise CRON_SECRET, BREVO_* et NEXT_PUBLIC_APP_URL ci-dessus.
# Migration 20260204000000_mail_notifications.sql (colonnes *_sent_at = idempotence) à appliquer avant le premier appel.

# --- Pages d'acquisition (/lp/essai, /lp/rappel, /lp/installateurs, /lp/regies) ---
# Migration 20260210000000_landing_leads.sql (table landing_leads, écriture service_role uniquement) à appliquer avant la mise en ligne.
# LEADS_NOTIFY_EMAIL : adresse qui reçoit une alerte à chaque nouveau prospect (nom, téléphone cliquable, e-mail, créneau, campagne).
# Absente : un avertissement est journalisé et seule la confirmation au prospect part.
LEADS_NOTIFY_EMAIL=
# LANDING_IP_SALT : sel secret (>= 32 caractères aléatoires) pour hacher l'IP des prospects (HMAC-SHA256). Absent : l'IP n'est pas enregistrée.
LANDING_IP_SALT=
